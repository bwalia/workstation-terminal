;; Sandbox for terminal shells (local.sandbox_profile), macOS. See docs/OPSAPI.md
;; "Shells locked to their folder". Install root-owned, e.g. /usr/local/etc/sshweb/shell.sb (0644).
;; Parameters from sshweb: HOME (the shells' account folder) and OTLP_PORT (the work log's receiver).
;; Everything a shell starts (agents, git, builds) inherits it and can't loosen it.
(version 1)
(allow default)

;; Files. Of everything under /Users only the account's own folder: its projects and the tools'
;; settings and caches. No other account's files, and no disks under /Volumes.
(deny file-read* file-write* (subpath "/Users") (subpath "/Volumes"))
(allow file-read-metadata (literal "/Users"))
(allow file-read* file-write* (subpath (param "HOME")))
;; Shared set-up stays as the administrator left it: shell start-up files, the agents' Claude and
;; GitHub logins, git's identity and Claude's user settings (hooks there would run for everyone).
(deny file-write*
  (literal (string-append (param "HOME") "/.zprofile"))
  (literal (string-append (param "HOME") "/.zshrc"))
  (literal (string-append (param "HOME") "/.zshenv"))
  (literal (string-append (param "HOME") "/.zlogin"))
  (literal (string-append (param "HOME") "/.profile"))
  (literal (string-append (param "HOME") "/.bash_profile"))
  (literal (string-append (param "HOME") "/.bashrc"))
  (literal (string-append (param "HOME") "/.claude-token"))
  (literal (string-append (param "HOME") "/.gitconfig"))
  (literal (string-append (param "HOME") "/.claude/settings.json"))
  (subpath (string-append (param "HOME") "/.config/gh"))
  (subpath (string-append (param "HOME") "/.config/git")))

;; Places whose contents run in everyone's sessions stay as the administrator left them too, so
;; nobody can plant something there that runs when a colleague starts Claude or a shell: Claude's
;; commands, agents, skills, plugins, hooks, memory and local settings, and the folders on PATH or
;; loaded by zsh. Claude still keeps its own state (~/.claude.json, ~/.claude/projects, todos, ...).
(deny file-write*
  (subpath (string-append (param "HOME") "/.claude/commands"))
  (subpath (string-append (param "HOME") "/.claude/agents"))
  (subpath (string-append (param "HOME") "/.claude/skills"))
  (subpath (string-append (param "HOME") "/.claude/plugins"))
  (subpath (string-append (param "HOME") "/.claude/hooks"))
  (literal (string-append (param "HOME") "/.claude/CLAUDE.md"))
  (literal (string-append (param "HOME") "/.claude/settings.local.json"))
  (subpath (string-append (param "HOME") "/.local/bin"))
  ;; The Claude that ~/.local/bin/claude points to. Claude can't update itself from a tab; update
  ;; it as the account: sudo -iu workstation claude update.
  (subpath (string-append (param "HOME") "/.local/share/claude"))
  (subpath (string-append (param "HOME") "/bin"))
  (subpath (string-append (param "HOME") "/.oh-my-zsh"))
  (subpath (string-append (param "HOME") "/.zsh"))
  ;; ...nor can their folders be moved aside and replaced (by a link to a folder of one's own).
  (literal (string-append (param "HOME") "/.claude"))
  (literal (string-append (param "HOME") "/.config"))
  (literal (string-append (param "HOME") "/.local")))

;; Processes. A shell can inspect (open files, folder, path) and signal only what was started in its
;; own tab (its sandbox), not other people's shells and agents or the gateway. The list of processes
;; and their command lines (`pgrep -fl`) stays visible.
(deny process-info*)
(allow process-info* (target same-sandbox))
(deny signal)
(allow signal (target same-sandbox))

;; Network. Out to the web only (GitHub, Claude, OpsAPI, package registries): ports 443 and 80.
;; Nothing else, so not the services running on this Mac or the local network (databases, AI
;; servers, dashboards, file and screen sharing). Exceptions on this Mac: the work log's receiver
;; and the usual ports of a dev server someone starts in their own terminal. A sandbox profile
;; can't name address ranges, so local-network hosts on 443 and 80 stay reachable: block those with
;; pf (docs/OPSAPI.md, "Shells locked to their folder").
(deny network-outbound (remote ip "*:*"))
(allow network-outbound
  (remote tcp "*:443")
  (remote tcp "*:80")
  (remote ip (string-append "localhost:" (param "OTLP_PORT")))
  (remote ip "localhost:3000")
  (remote ip "localhost:3001")
  (remote ip "localhost:4173")
  (remote ip "localhost:5173")
  (remote ip "localhost:8000")
  (remote unix-socket))
